# Production environment for cPanel.
#
# Copy this to the application root on the server (alongside artisan, NOT in
# public_html) and fill in the marked values.
#
# APP_KEY: copy the exact value from your local .env. Do NOT run key:generate
# on the server — the mail password, New York Times key and Google
# service-account JSON are encrypted in the database against that key, and a
# new one makes every one of them silently unreadable.

APP_NAME="Yeah Kenyan Events Limited"
APP_ENV=production
APP_KEY=                      # paste from local .env, unchanged
APP_DEBUG=false
APP_URL=https://yeahkenyan.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# From cPanel → MySQL Databases. Names are usually prefixed with the account.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail, analytics and the news feed are all configured through the dashboard
# and stored in the database, so nothing more is needed here.
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="info@yeahkenyan.com"
MAIL_FROM_NAME="${APP_NAME}"
